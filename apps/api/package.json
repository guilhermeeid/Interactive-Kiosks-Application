{
  "name": "@totem/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend (Node.js + TypeScript + Fastify) do totem de autoatendimento.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@totem/shared": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "fastify": "^4.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
