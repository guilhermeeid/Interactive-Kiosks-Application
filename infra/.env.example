# ---- PostgreSQL (infra/docker-compose.yml) ----
POSTGRES_USER=totem
# Obrigatório: sem valor-padrão no docker-compose.yml. Gere uma senha própria,
# nunca reutilize o exemplo abaixo nem commite o arquivo .env real.
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=totem_autoatendimento
POSTGRES_PORT=5432

# ---- apps/api ----
DATABASE_URL=postgresql://totem:troque-esta-senha@localhost:5432/totem_autoatendimento
API_PORT=3333
# Senhas dos usuários que a API cria na primeira vez que sobe, sem nenhum usuário do
# painel (http://localhost:5173/admin): `admin` (perfil Administrador) e `funcionario`
# (perfil Funcionário). Depois disso não têm mais efeito: usuários e senhas são geridos
# na aba Usuários. Sem estas variáveis a API usa admin1234 e func1234, o que só serve
# para desenvolvimento. Mínimo de 8 caracteres.
ADMIN_SENHA_INICIAL=troque-esta-senha
FUNCIONARIO_SENHA_INICIAL=troque-esta-outra-senha
# Opcional: pasta onde a API grava a configuração do administrador e as imagens
# (padrão: apps/api/data).
# DATA_DIR=

# ---- apps/totem ----
VITE_API_URL=http://localhost:3333
