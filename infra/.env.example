# ---- PostgreSQL (infra/docker-compose.yml) ----
POSTGRES_USER=totem
# Obrigatório: sem valor-padrão no docker-compose.yml. Gere uma senha própria,
# nunca reutilize o exemplo abaixo nem commite o arquivo .env real.
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=totem_autoatendimento
POSTGRES_PORT=5432

# ---- apps/api ----
DATABASE_URL=postgresql://totem:troque-esta-senha@localhost:5432/totem_autoatendimento
API_PORT=3333
# PINs da área restrita (http://localhost:5173/admin). O PIN define o modo:
# Administrador (muda tudo; vale quando o servidor reiniciar) ou Funcionário (esgotado,
# preço, foto, descrição e caixa; vale na hora). Sem estas variáveis a API usa 1234 e
# 0000, o que só serve para desenvolvimento. Use PINs diferentes.
ADMIN_PIN=troque-este-pin
FUNCIONARIO_PIN=troque-este-outro-pin
# Área restrita: 5 PINs errados seguidos bloqueiam a entrada por este tempo (padrão 5)
# e a sessão expira depois deste tempo sem uso (padrão 30).
# ACESSO_BLOQUEIO_MINUTOS=5
# SESSAO_INATIVA_MINUTOS=30
# Pix: validade do QR Code (padrão 300 s), espera máxima pelo banco (padrão 10000 ms) e
# o segredo que o banco manda no cabeçalho x-webhook-token do webhook
# (POST /pagamento/pix/webhook). Defina um segredo próprio em uso real.
# PIX_EXPIRACAO_SEGUNDOS=300
# PIX_TEMPO_LIMITE_MS=10000
PIX_WEBHOOK_TOKEN=troque-este-segredo
# NFC-e: espera máxima pela autorização (padrão 15000 ms).
# FISCAL_TEMPO_LIMITE_MS=15000
# Comprovante por e-mail de verdade (SMTP). Sem SMTP_HOST, o e-mail é simulado (só
# aparece no log da API). Ex.: Gmail = smtp.gmail.com, porta 587, usuário = o e-mail e
# senha = uma "senha de app" (não a senha normal). O SMS continua simulado.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_USUARIO=comprovantes@exemplo.com
# SMTP_SENHA=troque-esta-senha-de-app
# SMTP_REMETENTE="Lanchonete <comprovantes@exemplo.com>"
# NOTIFICACAO_TEMPO_LIMITE_MS=20000
# Só desenvolvimento — simulação dos mocks (ver README):
# MOCK_NOTIFICACAO_FALHA=           (sempre, email, sms, ou uma chance entre 0 e 1)
# MOCK_PIX_PAGAR_APOS_SEGUNDOS=10   (ou "nunca": o QR expira; pague pelo simulador)
# MOCK_PIX_ATRASO_MS=0              (acima de PIX_TEMPO_LIMITE_MS: aviso de instabilidade)
# MOCK_PIX_WEBHOOK_ATRASO_MS=0
# MOCK_FISCAL_FALHA=                (sempre, ou uma chance entre 0 e 1)
# Opcional: pasta onde a API grava a configuração do administrador e as imagens
# (padrão: apps/api/data).
# DATA_DIR=

# ---- apps/totem ----
VITE_API_URL=http://localhost:3333
