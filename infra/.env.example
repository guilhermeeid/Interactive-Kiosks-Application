# ---- PostgreSQL (infra/docker-compose.yml) ----
POSTGRES_USER=totem
# Obrigatório: sem valor-padrão no docker-compose.yml. Gere uma senha própria,
# nunca reutilize o exemplo abaixo nem commite o arquivo .env real.
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=totem_autoatendimento
POSTGRES_PORT=5432

# ---- apps/api ----
DATABASE_URL=postgresql://totem:troque-esta-senha@localhost:5432/totem_autoatendimento
API_PORT=3333
# PINs da área restrita (http://localhost:5173/admin). O PIN define o modo:
# Administrador (muda tudo; vale quando o servidor reiniciar) ou Funcionário (esgotado,
# preço, foto, descrição e caixa; vale na hora). Sem estas variáveis a API usa 1234 e
# 0000, o que só serve para desenvolvimento. Use PINs diferentes.
ADMIN_PIN=troque-este-pin
FUNCIONARIO_PIN=troque-este-outro-pin
# Opcional: pasta onde a API grava a configuração do administrador e as imagens
# (padrão: apps/api/data).
# DATA_DIR=

# ---- apps/totem ----
VITE_API_URL=http://localhost:3333
